// Character rows added to the generated aVkToWch2 table by .github/workflows/build-windows.yml.
// MSKLC cannot put characters on function keys, so they live outside NorKEY.klc.
// F16-F18 type the letters without AltGr, which World of Warcraft chat reads as Ctrl+Alt shortcuts.
  {VK_F16, CAPLOK, 0x00e6, 0x00c6}, // ae, AE
  {VK_F17, CAPLOK, 0x00f8, 0x00d8}, // o-slash, O-slash
  {VK_F18, CAPLOK, 0x00e5, 0x00c5}, // a-ring, A-ring
